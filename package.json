    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@playwright/test": "^1.55.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
